<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PAIA - System Settings</title>
    <!-- Use absolute paths starting with slash since static path prefix is '/' -->
    <link href="/css/cybercore.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/chat.css">
    <script src="/js/theme.js"></script>
</head>

<body class="cyber-theme" style="overflow: auto;">
    <div class="container">
        <!-- Main Settings Area -->
        <div style="align-items: center; max-width: 75%; margin: 0 auto;">

            <div class="logo-panel">
                <div class="logo" data-text="PAIAgent">
                    Open PAIAgent Setup
                </div>
            </div>

            <div id="setupWarningBanner" class="warning-banner">
                ⚠️ FIRST LAUNCH SETUP: Please configure the AI API Key below to enable chat functions.
            </div>

            <div class="settings-form-container">
                <div class="sessions-title cyber-text-glow"
                    style="font-size: 18px; border-bottom: 1px solid rgba(0, 255, 136, 0.3); padding-bottom: 8px; margin-bottom: 10px;">
                    AGENT CONFIGURATION
                </div>

                <div class="form-group">
                    <label class="cyber-label">UI Theme</label>
                    <select class="cyber-select cyber-theme-select"
                        style="width: 100%; font-family: var(--font-mono); padding: 8px;">
                        <option value="dark">🌙 Cyber Dark (Default)</option>
                        <option value="light">☀️ Modern Light</option>
                    </select>
                    <small
                        style="display: block; font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); margin-top: 5px;">
                        Select your preferred color theme for the interface.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">AI
                        API URL</label>
                    <input type="text" id="settingsAiApiUrl" class="cyber-input"
                        placeholder="https://openrouter.ai/api/v1/chat/completions">
                    <small class="cyber-label-small">
                        Configure
                        the LLM completions URL. Leave default or change for OpenAI, LM Studio, Ollama, etc.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">AI
                        Model</label>
                    <input type="text" id="settingsAiDefaultModel" class="cyber-input"
                        placeholder="qwen/qwen3.5-flash-02-23">
                    <small class="cyber-label-small">
                        Configure
                        the default model identifier (e.g. qwen/qwen3.5-flash-02-23, or llama3 for Ollama).</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">AI API Key</label>
                    <input type="password" id="settingsAiApiKey" class="cyber-input" placeholder="Not configured">
                    <small class="cyber-label-small">
                        Required.
                        Used for LLM chat. Enter new key to update, leave empty to keep current, or enter '-' to
                        clear.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">Together
                        AI API Key</label>
                    <input type="password" id="settingsTogetherApiKey" class="cyber-input" placeholder="Not configured">
                    <small class="cyber-label-small">
                        Optional.
                        For image generation features. Enter '-' to clear.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">X.AI
                        API Key</label>
                    <input type="password" id="settingsXaiApiKey" class="cyber-input" placeholder="Not configured">
                    <small class="cyber-label-small">
                        Optional.
                        For Grok image generation. Enter '-' to clear.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">Telegram
                        Bot Token</label>
                    <input type="password" id="settingsTelegramToken" class="cyber-input" placeholder="Not configured">
                    <small class="cyber-label-small">
                        Optional.
                        For telegram bot interactions. Enter '-' to clear.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">Allowed
                        Telegram User IDs</label>
                    <input type="text" id="settingsAllowedTelegramUserIds" class="cyber-input"
                        placeholder="e.g. 1234567,8901234">
                    <small class="cyber-label-small">
                        Optional.
                        Comma-separated list of Telegram User IDs. Leave empty to allow anyone.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">Basic
                        Auth Username</label>
                    <input type="text" id="settingsAppUser" class="cyber-input" placeholder="admin">
                    <small class="cyber-label-small">
                        Username
                        for Web UI protection. Default is 'admin'.</small>
                </div>

                <div class="form-group">
                    <label class="cyber-label">Basic
                        Auth Password</label>
                    <input type="password" id="settingsAppPassword" class="cyber-input" placeholder="Not configured">
                    <small class="cyber-label-small">
                        Optional.
                        Leave empty to disable authentication. Enter new password to update, or '-' to clear.</small>
                </div>

                <div class="form-group">
                    <button id="btnSaveSettings" class="cyber-btn">
                        SAVE CONFIG
                    </button>
                </div>
            </div>


        </div>
    </div>

    <script src="/js/settings.js"></script>
</body>

</html>