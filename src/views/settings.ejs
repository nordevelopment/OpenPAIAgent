<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PAIA - System Settings</title>
    <!-- Use absolute paths starting with slash since static path prefix is '/' -->
    <link href="/css/cybercore.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/chat.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="/js/theme.js"></script>
    <style>
        /* Select2 Cyber Theme Customization */
        .select2-container--default .select2-selection--single {
            background-color: var(--color-bg-card, #111625) !important;
            border: 1px solid var(--color-border, rgba(0, 255, 136, 0.3)) !important;
            border-radius: 4px !important;
            height: 38px !important;
            padding: 4px 8px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: var(--color-text-main, #e2e8f0) !important;
            font-family: var(--font-mono, monospace) !important;
            line-height: 28px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }

        .select2-dropdown {
            background-color: #0f1422 !important;
            border: 1px solid rgba(0, 255, 136, 0.4) !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8) !important;
            color: #e2e8f0 !important;
            font-family: var(--font-mono, monospace) !important;
        }

        .select2-search__field {
            background-color: #1a2035 !important;
            color: #00ff88 !important;
            border: 1px solid rgba(0, 255, 136, 0.3) !important;
            font-family: var(--font-mono, monospace) !important;
            border-radius: 4px !important;
        }

        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: rgba(0, 255, 136, 0.2) !important;
            color: #00ff88 !important;
        }

        .select2-container--default .select2-results__option[aria-selected=true] {
            background-color: rgba(0, 255, 136, 0.1) !important;
            color: #00ff88 !important;
        }

        /* 2-Column Grid Layout for Settings */
        .settings-grid-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .settings-card {
            background: rgba(17, 22, 37, 0.85);
            border: 1px solid rgba(0, 255, 136, 0.2);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
        }

        [data-theme="light"] .settings-card {
            background: #ffffff;
            border-color: rgba(0, 0, 0, 0.2);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .settings-card-header {
            font-size: 16px;
            font-weight: bold;
            font-family: var(--font-mono, monospace);
            color: #00ff88;
            border-bottom: 1px solid rgba(0, 255, 136, 0.3);
            padding-bottom: 8px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        [data-theme="light"] .settings-card-header {
            color: #333;
            border-bottom-color: #ccc;
        }

        @media (max-width: 900px) {
            .settings-grid-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body class="cyber-theme" style="overflow: auto;">
    <div class="container">
        <!-- Main Settings Area -->
        <div style="max-width: 960px; margin: 0 auto; padding-bottom: 40px;">

            <div class="logo-panel" style="margin-bottom: 15px;">
                <div class="logo" data-text="PAIAgent">
                    Open PAIAgent Setup
                </div>
            </div>

            <div id="setupWarningAlert" class="cyber-warning-alert" style="margin-bottom: 20px;">
                ⚠️ PREVIEW MODE: Please configure the AI API Key below to enable chat functions.
            </div>

            <!-- Two-Column Grid -->
            <div class="settings-grid-layout">

                <!-- Block 1: AI & Core Settings -->
                <div class="settings-card">
                    <div class="settings-card-header cyber-text-glow">
                        <span>🧠</span> CORE AI & INTERFACE
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">UI Theme</label>
                        <select class="cyber-select cyber-theme-select"
                            style="width: 100%; font-family: var(--font-mono); padding: 8px;">
                            <option value="dark">🌙 Cyber Dark (Default)</option>
                            <option value="light">☀️ Modern Light</option>
                        </select>
                        <small class="cyber-label-small">Select your preferred color theme for the interface.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">AI Provider Preset</label>
                        <select id="settingsAiProvider" class="cyber-select"
                            style="width: 100%; font-family: var(--font-mono); padding: 8px;">
                            <option value="custom">Loading providers...</option>
                        </select>
                        <small class="cyber-label-small">
                            Select a provider preset to automatically set completion URL and model options.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">AI API URL <span style="color: #ff4444;">*</span></label>
                        <input type="text" id="settingsAiApiUrl" class="cyber-input"
                            placeholder="https://openrouter.ai/api/v1/chat/completions">
                        <small class="cyber-label-small">
                            Configure the LLM completions URL. Automatically set by preset or customize
                            manually.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">AI Model</label>
                        <select id="settingsAiModelSelect" class="cyber-select"
                            style="width: 100%; font-family: var(--font-mono); padding: 8px; margin-bottom: 8px; display: none;">
                            <option value="">Select a model...</option>
                        </select>
                        <input type="text" id="settingsAiDefaultModel" class="cyber-input"
                            placeholder="qwen/qwen3.7-flash" autocomplete="off">
                        <div id="aiModelPriceBadge"
                            style="display: none; font-family: var(--font-mono); font-size: 12px; color: #00ff88; margin-top: 6px; padding: 6px 10px; background: rgba(0, 255, 136, 0.08); border-radius: 4px; border: 1px solid rgba(0, 255, 136, 0.2);">
                        </div>
                        <small class="cyber-label-small">
                            Select model from dropdown or type any custom model ID.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">AI API Key <span style="color: #ff4444;">*</span></label>
                        <input type="password" id="settingsAiApiKey" class="cyber-input" placeholder="Not configured">
                        <small class="cyber-label-small">
                            Required. Used for LLM chat. Enter new key to update, leave empty to keep current, or enter
                            '-'
                            to clear.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Basic Auth Username</label>
                        <input type="text" id="settingsAppUser" class="cyber-input" placeholder="admin">
                        <small class="cyber-label-small">
                            Username for Web UI protection. Default is 'admin'.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Basic Auth Password</label>
                        <input type="password" id="settingsAppPassword" class="cyber-input"
                            placeholder="Not configured">
                        <small class="cyber-label-small">
                            Optional. Leave empty to disable authentication. Enter new password to update, or '-' to
                            clear.</small>
                    </div>
                </div>

                <!-- Block 2: Media & Integrations -->
                <div class="settings-card">
                    <div class="settings-card-header cyber-text-glow">
                        <span>🎨</span> MEDIA & INTEGRATIONS
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Together AI API Key</label>
                        <input type="password" id="settingsTogetherApiKey" class="cyber-input"
                            placeholder="Not configured">
                        <small class="cyber-label-small">
                            Optional. For image generation features. Enter '-' to clear.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Together Image Model</label>
                        <input type="text" id="settingsTogetherImageModel" class="cyber-input"
                            placeholder="black-forest-labs/FLUX.2-dev">
                        <small class="cyber-label-small">
                            Default: <code>black-forest-labs/FLUX.2-dev</code> or any supported Together AI image
                            model.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">X.AI (Grok) API Key</label>
                        <input type="password" id="settingsXaiApiKey" class="cyber-input" placeholder="Not configured">
                        <small class="cyber-label-small">
                            Optional. For Grok image generation. Enter '-' to clear.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Telegram Bot Token</label>
                        <input type="password" id="settingsTelegramToken" class="cyber-input"
                            placeholder="Not configured">
                        <small class="cyber-label-small">
                            Optional. For telegram bot interactions. Enter '-' to clear.</small>
                    </div>

                    <div class="form-group">
                        <label class="cyber-label">Allowed Telegram User IDs</label>
                        <input type="text" id="settingsAllowedTelegramUserIds" class="cyber-input"
                            placeholder="e.g. 1234567,8901234">
                        <small class="cyber-label-small">
                            Optional. Comma-separated list of Telegram User IDs. Leave empty to allow anyone.</small>
                    </div>
                </div>

            </div>

            <!-- Full Width Action Button -->
            <div style="margin-top: 10px;">
                <button id="btnSaveSettings" class="cyber-btn" style="width: 100%; padding: 14px; font-size: 16px;">
                    💾 SAVE CONFIGURATION
                </button>
            </div>

        </div>
    </div>

    <script src="/js/settings.js"></script>
</body>

</html>